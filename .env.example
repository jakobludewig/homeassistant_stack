# Copy to .env and adjust. .env is git-ignored, never commit it.
TZ=Europe/Berlin
APPDATA=/mnt/user/appdata

# Stable path of the dongle, find it with: ls -l /dev/serial/by-id/
ZIGBEE_DEVICE=/dev/serial/by-id/CHANGE-ME

# Adapter driver: ember (Sonoff ZBDongle-E, HA ZBT-1/Connect),
# zstack (Sonoff ZBDongle-P, CC2652-based), ezsp (older EFR32 firmware), or auto
ZIGBEE_ADAPTER=zstack

# --- Secrets ---
# Constraints: letters, digits and - _ . only. No $ # " ' \ or spaces
# (they break compose's .env parsing). At least 20 characters.

# MQTT login used by Zigbee2MQTT. Must match the user created with mosquitto_passwd.
Z2M_MQTT_USER=z2m
Z2M_MQTT_PASSWORD=CHANGE-ME

# Password for the Zigbee2MQTT web UI (prompted at login).
Z2M_FRONTEND_TOKEN=CHANGE-ME
